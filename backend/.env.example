# Copia este archivo como .env y cambia los valores
AWS_REGION=us-east-1
TABLE_NAME=short_links
# IP pública de tu EC2 (se usa para armar el enlace corto)
BASE_URL=http://<ip-publica-ec2>:8000
# URL del sitio web de S3 (o * para permitir todo mientras pruebas)
CORS_ORIGINS=http://<tu-bucket>.s3-website-us-east-1.amazonaws.com
